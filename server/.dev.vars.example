# so we can reject requests that don't actually come from Telegram
TELEGRAM_WEBHOOK_SECRET=choose-a-random-secret-string
# Bot's @username (no @), used to build the t.me deep link sent to the app
TELEGRAM_BOT_USERNAME=YourBotUsername
